<?xml version="1.0" encoding="utf-8"?>
<!-- 開発版だけに入る設定。正式版（release）には含まれない。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- ウィジェットの6つの状態を adb から切り替えて確かめる（DUMP の権限が要るので adb からしか呼べない） -->
        <receiver
            android:name=".widget.DebugWidgetReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- 初回設定をやり直す（完了状態と使い方を消す）。DUMP の権限が要るので adb からしか呼べない -->
        <receiver
            android:name=".ui.setup.DebugSetupReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- 記録をまとめて n 日前にずらす（履歴と比較の確認用）。DUMP の権限が要るので adb からしか呼べない -->
        <receiver
            android:name=".data.record.DebugShiftRecordsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- この端末のデータを「別の端末のファイル」として書き出す（取り込みの確認用）。DUMP の権限が要るので adb からしか呼べない -->
        <receiver
            android:name=".data.transfer.DebugExportReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>

</manifest>
